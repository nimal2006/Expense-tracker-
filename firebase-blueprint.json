{
  "entities": {
    "expense": {
      "title": "Expense",
      "description": "An individual expense transaction recorded by a member.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Unique identifier for the expense." },
        "member": { "type": "string", "enum": ["Nimal", "Etti", "Dharan", "Sanjai", "Santhosh", "Sujhay"], "description": "The member who made the expense." },
        "amount": { "type": "number", "description": "The amount spent." },
        "category": { "type": "string", "maxLength": 100, "description": "The category of the expense." },
        "paymentMode": { "type": "string", "enum": ["UPI", "Cash", "Card", "Friend Paid"], "description": "The mode of payment used." },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "The date of the expense in YYYY-MM-DD format." },
        "time": { "type": "string", "maxLength": 32, "description": "The time of the expense (HH:mm or ISO)." },
        "itemName": { "type": "string", "maxLength": 200, "description": "Optional name of the item purchased." },
        "quantity": { "type": "number", "description": "Optional quantity of the item." },
        "place": { "type": "string", "maxLength": 200, "description": "Optional place where the expense occurred." },
        "notes": { "type": "string", "maxLength": 500, "description": "Optional notes for the expense." },
        "receiptUrl": { "type": "string", "maxLength": 400000, "description": "Optional compressed receipt data URL." },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 100, "description": "Timestamp when the record was created." },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 100, "description": "Timestamp when the record was last updated." }
      },
      "required": ["id", "member", "amount", "category", "paymentMode", "date", "createdAt"]
    },
    "budget": {
      "title": "Budget",
      "description": "Monthly budget settings for the group or individual members.",
      "type": "object",
      "properties": {
        "key": { "type": "string", "maxLength": 128, "description": "Unique key for the budget (e.g., '2026-08' or 'Nimal_2026-08')." },
        "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$", "description": "The month the budget applies to in YYYY-MM format." },
        "member": { "type": "string", "enum": ["Nimal", "Etti", "Dharan", "Sanjai", "Santhosh", "Sujhay"], "description": "Optional member the budget belongs to." },
        "amount": { "type": "number", "description": "The budget amount." },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 100, "description": "Timestamp when the record was last updated." }
      },
      "required": ["key", "month", "amount", "updatedAt"]
    },
    "avatar": {
      "title": "Member Avatar",
      "description": "Custom avatar photo or URL for a roommate.",
      "type": "object",
      "properties": {
        "member": { "type": "string", "enum": ["Nimal", "Etti", "Dharan", "Sanjai", "Santhosh", "Sujhay"], "description": "The member whose avatar is being set." },
        "avatarUrl": { "type": "string", "maxLength": 400000, "description": "Base64 data URL or external image URL for the avatar." },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 100, "description": "Timestamp when the avatar was last updated." }
      },
      "required": ["member", "updatedAt"]
    },
    "busSchedule": {
      "title": "Bus Schedule",
      "description": "Manually entered shared group bus schedule and ticket fare.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Unique identifier for the bus schedule." },
        "busName": { "type": "string", "minLength": 1, "maxLength": 120, "description": "Display name of the bus service." },
        "busNumber": { "type": "string", "maxLength": 40, "description": "Route or registration number of the bus." },
        "operator": { "type": "string", "enum": ["Government", "Private"], "description": "Bus operator category." },
        "fromLocation": { "type": "string", "minLength": 1, "maxLength": 120, "description": "Departure point." },
        "toLocation": { "type": "string", "minLength": 1, "maxLength": 120, "description": "Destination point." },
        "departureTime": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$", "description": "Departure time in 24h HH:mm format." },
        "arrivalTime": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$", "description": "Arrival time in 24h HH:mm format." },
        "ticketPrice": { "type": "number", "description": "Manual ticket fare in INR (>= 0)." },
        "busType": { "type": "string", "enum": ["Ordinary", "Express", "AC", "Deluxe"], "description": "Bus comfort class." },
        "operatingDays": { "type": "array", "description": "Weekdays on which the bus operates (Mon-Sun, max 7 items)." },
        "notes": { "type": "string", "maxLength": 400, "description": "Optional boarding point or fare notes." },
        "createdBy": { "type": "string", "enum": ["Nimal", "Etti", "Dharan", "Sanjai", "Santhosh", "Sujhay"], "description": "Member who added this bus schedule." },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 100, "description": "Creation ISO timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 100, "description": "Last update ISO timestamp." }
      },
      "required": ["id", "busName", "busNumber", "operator", "fromLocation", "toLocation", "departureTime", "arrivalTime", "ticketPrice", "busType", "operatingDays", "createdBy", "createdAt", "updatedAt"]
    },
    "notificationPreference": {
      "title": "Notification Preference",
      "description": "Per-member notification settings and favourite bus IDs (never stores FCM tokens).",
      "type": "object",
      "properties": {
        "member": { "type": "string", "enum": ["Nimal", "Etti", "Dharan", "Sanjai", "Santhosh", "Sujhay"], "description": "Member name." },
        "dailyReminderEnabled": { "type": "boolean", "description": "Whether daily expense reminders are active." },
        "friendActivityEnabled": { "type": "boolean", "description": "Whether friend expense activity alerts are active." },
        "notifyOnEdits": { "type": "boolean", "description": "Whether to notify when friends edit existing expenses." },
        "reminderTime": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$", "description": "Daily reminder time in HH:mm (Asia/Kolkata)." },
        "timezone": { "type": "string", "maxLength": 64, "description": "IANA timezone string, defaults to Asia/Kolkata." },
        "soundEnabled": { "type": "boolean", "description": "Whether notification sound chime is enabled." },
        "favouriteBusIds": { "type": "array", "description": "Per-member favourite bus schedule IDs (max 100)." },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 100, "description": "Last update ISO timestamp." }
      },
      "required": ["member", "dailyReminderEnabled", "friendActivityEnabled", "notifyOnEdits", "reminderTime", "timezone", "soundEnabled", "favouriteBusIds", "updatedAt"]
    },
    "notificationLog": {
      "title": "Notification Log",
      "description": "Idempotent notification delivery log for daily reminders and friend expense activity.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Deterministic idempotency key." },
        "type": { "type": "string", "enum": ["daily_reminder", "friend_activity"], "description": "Category of notification." },
        "recipientMember": { "type": "string", "enum": ["Nimal", "Etti", "Dharan", "Sanjai", "Santhosh", "Sujhay"], "description": "Member receiving the notification." },
        "actorMember": { "type": "string", "enum": ["Nimal", "Etti", "Dharan", "Sanjai", "Santhosh", "Sujhay"], "description": "Member who created the expense." },
        "expenseId": { "type": "string", "maxLength": 128, "description": "Referenced expense ID for deep-linking." },
        "title": { "type": "string", "maxLength": 120, "description": "Notification title." },
        "message": { "type": "string", "maxLength": 300, "description": "Notification body text." },
        "dateKey": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "IST calendar date YYYY-MM-DD." },
        "attemptNumber": { "type": "number", "description": "Daily reminder attempt (1 or 2)." },
        "snoozeUntil": { "type": "string", "maxLength": 100, "description": "Optional ISO timestamp for 60m snooze." },
        "read": { "type": "boolean", "description": "Whether the recipient has read this notification." },
        "metadata": { "type": "object", "description": "Non-sensitive expense summary metadata." },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 100, "description": "Creation ISO timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 100, "description": "Last update ISO timestamp." }
      },
      "required": ["id", "type", "recipientMember", "title", "message", "dateKey", "read", "createdAt"]
    },
    "deviceToken": {
      "title": "FCM Device Token",
      "description": "Write-only client device push token store (strictly non-readable from client SDKs; read only by Cloud Functions Admin SDK).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Hashed/deterministic device token record ID." },
        "member": { "type": "string", "enum": ["Nimal", "Etti", "Dharan", "Sanjai", "Santhosh", "Sujhay"], "description": "Member owning this device token." },
        "token": { "type": "string", "minLength": 10, "maxLength": 512, "description": "FCM registration token." },
        "platform": { "type": "string", "enum": ["web", "android-pwa", "ios-pwa"], "description": "Device platform." },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 100, "description": "Last refresh ISO timestamp." }
      },
      "required": ["id", "member", "token", "platform", "updatedAt"]
    }
  },
  "firestore": {
    "/expenses/{expenseId}": {
      "schema": "expense",
      "description": "Collection of all expenses."
    },
    "/budgets/{budgetKey}": {
      "schema": "budget",
      "description": "Collection of monthly budgets."
    },
    "/avatars/{memberId}": {
      "schema": "avatar",
      "description": "Collection of member avatars."
    },
    "/busSchedules/{busId}": {
      "schema": "busSchedule",
      "description": "Shared group bus schedules and manually entered ticket fares."
    },
    "/notificationPreferences/{memberId}": {
      "schema": "notificationPreference",
      "description": "Per-member notification preferences and personal favourite bus IDs."
    },
    "/notificationLogs/{notificationId}": {
      "schema": "notificationLog",
      "description": "Idempotent notification log for daily reminders and friend expense alerts."
    },
    "/deviceTokens/{tokenId}": {
      "schema": "deviceToken",
      "description": "Isolated FCM device tokens (write-only for clients, read-only for Cloud Functions Admin SDK)."
    }
  }
}
